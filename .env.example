# =============================================================================
# Dastyar AI - Environment Configuration Example
# =============================================================================
# This file contains all available configuration options with descriptions.
# To use:
#   1. Copy this file to `.env` (git-ignored)
#   2. OR create a `config.json` file with these settings
#   3. Update the values according to your environment
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port the server will listen on
# Default: 3000
PORT=3000

# Host address to bind to
# Use 127.0.0.1 for localhost only, or 0.0.0.0 to allow external connections
# Default: 127.0.0.1
HOST=127.0.0.1

# Allowed CORS origins (comma-separated list)
# For development, include both the web dev server and production port
# For production, specify exact domains. Avoid using "*" in production!
# Default: http://localhost:3000,http://localhost:5173
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT secret key for token signing
# ⚠️ CRITICAL: This is a development default. REGENERATE for production!
# Must be at least 32 characters
# Generate a new secure key with: openssl rand -base64 48
# This default value is shared in the repository - DO NOT use in production
# Default (DEV ONLY): ***REMOVED***
JWT_SECRET=***REMOVED***

# JWT token expiration time in seconds
# Default: 86400 (24 hours)
# Examples:
#   - 3600 = 1 hour
#   - 86400 = 24 hours
#   - 604800 = 7 days
JWT_EXPIRES_IN=86400

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Path to SQLite database file
# Relative or absolute path supported
# Default: ./data.db
DATABASE_FILE=./data.db

# =============================================================================
# WHISPER (SPEECH-TO-TEXT) CONFIGURATION
# =============================================================================

# Whisper server URL (local Go server)
# This is the internal whisper.cpp server for audio transcription
# Default: http://127.0.0.1:8080
WHISPER_SERVER_URL=http://127.0.0.1:8080

# Whisper API request timeout in milliseconds
# Longer audio files need more time
# Default: 120000 (2 minutes)
WHISPER_TIMEOUT_MS=120000

# Whisper model to use
# Options: tiny, base, small, medium, large, large-v2, large-v3
# Larger models are more accurate but slower and use more memory:
#   - tiny: ~75 MB, fastest, lowest accuracy
#   - base: ~142 MB
#   - small: ~466 MB
#   - medium: ~1.5 GB
#   - large: ~2.9 GB, slowest, highest accuracy
# Default: tiny
WHISPER_MODELS=tiny

# =============================================================================
# OLLAMA CONFIGURATION (Local Open-Source LLM)
# =============================================================================

# Ollama server base URL
# Ollama runs large language models locally
# Install from: https://ollama.ai/
# Default: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Enable/disable Ollama integration
# Set to false if Ollama is not installed
# Default: true
OLLAMA_ENABLED=true

# =============================================================================
# LMSTUDIO CONFIGURATION (Local LLM with GUI)
# =============================================================================

# LM Studio server base URL
# LM Studio is a GUI application for running LLMs locally
# Download from: https://lmstudio.ai/
# Default: http://localhost:1234/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Enable/disable LM Studio integration
# Set to false if LM Studio is not installed
# Default: true
LMSTUDIO_ENABLED=true

# =============================================================================
# GROQ CONFIGURATION (Cloud API - Fast Inference)
# =============================================================================

# Groq API key
# Get your free API key from: https://console.groq.com/
# Groq offers fast inference for models like Llama 3, Mixtral, etc.
# Default: (empty)
GROQ_API_KEY=

# Enable/disable Groq integration
# Set to true after adding your API key
# Default: false
GROQ_ENABLED=false

# =============================================================================
# GEMINI CONFIGURATION (Google Cloud API)
# =============================================================================

# Google Gemini API key
# Get your API key from: https://ai.google.dev/
# Gemini offers multimodal AI capabilities
# Default: (empty)
GEMINI_API_KEY=

# Enable/disable Gemini integration
# Set to true after adding your API key
# Default: false
GEMINI_ENABLED=false

# =============================================================================
# STABLE DIFFUSION CONFIGURATION (Image Generation)
# =============================================================================

# Stable Diffusion Web UI URL (AUTOMATIC1111)
# Install from: https://github.com/AUTOMATIC1111/stable-diffusion-webui
# Make sure to start with --api flag
# Default: http://localhost:7860
STABLE_DIFFUSION_URL=http://localhost:7860

# Enable/disable Stable Diffusion integration
# Set to false if Stable Diffusion is not installed
# Default: true
STABLE_DIFFUSION_ENABLED=true

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# Directory for storing generated images
# Relative or absolute path supported
# Will be created automatically if it doesn't exist
# Default: ./generated-images
IMAGES_DIR=./generated-images

# Directory for storing uploaded documents
# Used for document chat and RAG (Retrieval Augmented Generation)
# Will be created automatically if it doesn't exist
# Default: ./uploaded-documents
DOCUMENTS_DIR=./uploaded-documents

# =============================================================================
# EMBEDDINGS CONFIGURATION (RAG - Retrieval Augmented Generation)
# =============================================================================

# Embedding model for document indexing
# This should be an Ollama model name
# Common options:
#   - nomic-embed-text: Fast, good quality, 768 dimensions
#   - mxbai-embed-large: High quality, 1024 dimensions
# Install with: ollama pull <model-name>
# Default: nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# WEB FRONTEND CONFIGURATION
# =============================================================================

# Directory containing the built web frontend
# Used in production to serve the React app
# Default: ./web
WEB_DIST_DIR=./web

# =============================================================================
# OPTIONAL CONFIGURATION (Advanced)
# =============================================================================

# Node environment mode
# Options: development, production, test
# Default: development
NODE_ENV=development

# Enable detailed debug logging
# Set to true for verbose output during development
# Default: false
DEBUG=false

# Log level for application logging
# Options: error, warn, info, debug
# Default: info
LOG_LEVEL=info

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
#
# When deploying to production, make sure to:
#
# 1. ✅ Change JWT_SECRET to a strong random value
# 2. ✅ Set CORS_ORIGIN to your actual domain (not "*")
# 3. ✅ Use HOST=0.0.0.0 if behind a reverse proxy
# 4. ✅ Set NODE_ENV=production
# 5. ✅ Use a reverse proxy (nginx, Caddy) with HTTPS
# 6. ✅ Keep API keys secure (Groq, Gemini) - use secrets management
# 7. ✅ Set up proper file permissions for DATABASE_FILE
# 8. ✅ Consider using Redis for rate limiting in multi-instance deployments
# 9. ✅ Monitor logs and set up alerts
# 10. ✅ Regular backups of DATABASE_FILE and uploaded documents
#
# =============================================================================
