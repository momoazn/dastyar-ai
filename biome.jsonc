{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "javascript": {
    "globals": ["Bun"]
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noConsole": "off"
      },
      "performance": {
        "noImgElement": "off",
        "noBarrelFile": "off"
      },
      "style": {
        "noMagicNumbers": "off",
        "useBlockStatements": "off"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "options": {
            "maxAllowedComplexity": 20
          },
          "level": "error"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/server/src/lib/pdfjs-node-polyfills.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noUselessConstructor": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off"
          },
          "nursery": {
            "useMaxParams": "off",
            "noShadow": "off"
          }
        }
      }
    }
  ]
}
