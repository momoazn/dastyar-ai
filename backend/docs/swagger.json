{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "A comprehensive AI Assistant API that provides chat functionality, translation services, and model management. This API supports streaming chat responses, multi-language translation with tone control, and chat thread management.",
        "title": "Persian AI Assistant API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "API Support",
            "url": "http://www.swagger.io/support",
            "email": "support@swagger.io"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/chat": {
            "post": {
                "description": "Send a message to an AI model and receive a streamed response. This endpoint supports both standard and reasoning models. For reasoning models, the response includes thinking process in the reasoning field. The response is streamed as NDJSON (newline-delimited JSON) for real-time updates.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/x-ndjson"
                ],
                "tags": [
                    "Chat"
                ],
                "summary": "Stream chat response",
                "operationId": "sendChatMessage",
                "parameters": [
                    {
                        "description": "Chat request payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.ChatRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Streamed chat response (NDJSON format)",
                        "schema": {
                            "$ref": "#/definitions/handlers.ChatResponse"
                        }
                    },
                    "400": {
                        "description": "Bad request - missing required fields",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Chat thread not found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error - model or database error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/chat-threads": {
            "get": {
                "description": "Retrieve a paginated list of all chat threads, ordered by last update time (newest first)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Chat Threads"
                ],
                "summary": "Get all chat threads",
                "operationId": "getChatThreads",
                "responses": {
                    "200": {
                        "description": "List of chat threads with pagination info",
                        "schema": {
                            "$ref": "#/definitions/handlers.PaginatedResponse-db_ChatThread"
                        }
                    },
                    "500": {
                        "description": "Internal server error - database error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Create a new chat thread with a title and default model. This thread will be used to organize related chat messages.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Chat Threads"
                ],
                "summary": "Create a new chat thread",
                "operationId": "createChatThread",
                "parameters": [
                    {
                        "description": "Chat thread details",
                        "name": "chat_thread",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.CreateChatThreadRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Chat thread created successfully",
                        "schema": {
                            "$ref": "#/definitions/handlers.Response-db_ChatThread"
                        }
                    },
                    "400": {
                        "description": "Bad request - missing required fields",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error - database error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/chat-threads/{id}": {
            "get": {
                "description": "Retrieve a specific chat thread by its unique identifier, including all associated messages",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Chat Threads"
                ],
                "summary": "Get a chat thread by ID",
                "operationId": "getChatThread",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Chat thread ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Chat thread details with messages",
                        "schema": {
                            "$ref": "#/definitions/handlers.Response-db_ChatThread"
                        }
                    },
                    "404": {
                        "description": "Chat thread not found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error - database error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "description": "Update the title of an existing chat thread. The updated_at timestamp will be automatically updated.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Chat Threads"
                ],
                "summary": "Update a chat thread",
                "operationId": "updateChatThread",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Chat thread ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Chat thread details",
                        "name": "chat_thread",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.UpdateChatThreadRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Chat thread updated successfully",
                        "schema": {
                            "$ref": "#/definitions/handlers.Response-db_ChatThread"
                        }
                    },
                    "400": {
                        "description": "Bad request - missing required fields",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Chat thread not found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error - database error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Delete a chat thread and all associated messages. This action cannot be undone.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Chat Threads"
                ],
                "summary": "Delete a chat thread",
                "operationId": "deleteChatThread",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Chat thread ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Chat thread deleted successfully",
                        "schema": {
                            "$ref": "#/definitions/handlers.Response-any"
                        }
                    },
                    "404": {
                        "description": "Chat thread not found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error - database error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/chat-threads/{id}/messages": {
            "get": {
                "description": "Retrieve all messages in a chat thread, ordered by creation time (oldest first). Only user and assistant messages are returned.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Chat Threads"
                ],
                "summary": "Get chat thread messages",
                "operationId": "getChatThreadMessages",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Chat thread ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of messages in the chat thread",
                        "schema": {
                            "$ref": "#/definitions/handlers.PaginatedResponse-db_Message"
                        }
                    },
                    "404": {
                        "description": "Chat thread not found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error - database error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Check if the application and Ollama service are running and accessible. Returns 'ok' if all services are healthy.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Health"
                ],
                "summary": "Health check endpoint",
                "operationId": "healthCheck",
                "responses": {
                    "200": {
                        "description": "Service is healthy",
                        "schema": {
                            "$ref": "#/definitions/handlers.Response-string"
                        }
                    },
                    "500": {
                        "description": "Service is unhealthy - Ollama connection failed",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/list-model": {
            "get": {
                "description": "Get list of all available models from Ollama",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Model"
                ],
                "summary": "Get available models",
                "operationId": "getModels",
                "responses": {
                    "200": {
                        "description": "List of models",
                        "schema": {
                            "$ref": "#/definitions/handlers.Response-array_handlers_ModelListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/translations": {
            "get": {
                "description": "Retrieve a paginated list of all translation records, ordered by creation date (newest first)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Translations"
                ],
                "summary": "Get all translations",
                "operationId": "getTranslations",
                "responses": {
                    "200": {
                        "description": "List of translations with pagination info",
                        "schema": {
                            "$ref": "#/definitions/handlers.PaginatedResponse-db_Translation"
                        }
                    },
                    "500": {
                        "description": "Internal server error - database error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Translate text from one language to another using AI models. Supports multiple languages (Persian, English, Arabic, French, German, Spanish) and different tones (formal, casual, technical, friendly). The translation is processed synchronously and stored in the database.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Translations"
                ],
                "summary": "Create translation",
                "operationId": "createTranslation",
                "parameters": [
                    {
                        "description": "Translation request payload",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handlers.TranslateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Translation completed successfully",
                        "schema": {
                            "$ref": "#/definitions/handlers.Response-db_Translation"
                        }
                    },
                    "400": {
                        "description": "Bad request - missing required fields or invalid parameters",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Translation thread not found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error - model or database error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/translations/{id}": {
            "get": {
                "description": "Retrieve a specific translation record by its unique identifier",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Translations"
                ],
                "summary": "Get translation by ID",
                "operationId": "getTranslation",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Translation ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Translation details",
                        "schema": {
                            "$ref": "#/definitions/handlers.Response-db_Translation"
                        }
                    },
                    "404": {
                        "description": "Translation not found",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error - database error",
                        "schema": {
                            "$ref": "#/definitions/handlers.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "db.ChatThread": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "messages": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/db.Message"
                    }
                },
                "model": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "db.Message": {
            "type": "object",
            "properties": {
                "chat_thread_id": {
                    "type": "integer"
                },
                "content": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "model": {
                    "type": "string"
                },
                "reasoning": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                },
                "sent_at": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "db.Translation": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "model": {
                    "type": "string"
                },
                "source_language": {
                    "type": "string"
                },
                "source_text": {
                    "type": "string"
                },
                "target_language": {
                    "type": "string"
                },
                "tone": {
                    "type": "string"
                },
                "translated_text": {
                    "type": "string"
                }
            }
        },
        "handlers.ChatRequest": {
            "description": "Request payload for sending a chat message",
            "type": "object",
            "required": [
                "content",
                "model",
                "thread_id"
            ],
            "properties": {
                "content": {
                    "description": "The message content to send",
                    "type": "string",
                    "example": "Hello, how are you?"
                },
                "model": {
                    "description": "The model to use for the response",
                    "type": "string",
                    "example": "llama3.2:latest"
                },
                "thread_id": {
                    "description": "The chat thread ID to send the message to",
                    "type": "string",
                    "example": "123"
                }
            }
        },
        "handlers.ChatResponse": {
            "description": "Response payload for a chat message (used in streaming)",
            "type": "object",
            "properties": {
                "content": {
                    "description": "The message content",
                    "type": "string",
                    "example": "Hello! I'm doing well, thank you"
                },
                "id": {
                    "description": "Unique message ID",
                    "type": "integer",
                    "example": 456
                },
                "model": {
                    "description": "Model used",
                    "type": "string",
                    "example": "llama3.2:latest"
                },
                "reasoning": {
                    "description": "Reasoning content (for reasoning models)",
                    "type": "string",
                    "example": ""
                },
                "role": {
                    "description": "Message role (user or assistant)",
                    "type": "string",
                    "example": "assistant"
                },
                "sent_at": {
                    "description": "Timestamp when message was sent",
                    "type": "string",
                    "example": "2023-01-01T00:00:00Z"
                },
                "status": {
                    "description": "Message status (idle, reasoning, responding, done)",
                    "type": "string",
                    "example": "done"
                },
                "thread_id": {
                    "description": "Chat thread ID",
                    "type": "integer",
                    "example": 123
                }
            }
        },
        "handlers.CreateChatThreadRequest": {
            "description": "Request payload for creating a new chat thread",
            "type": "object",
            "required": [
                "model",
                "title"
            ],
            "properties": {
                "model": {
                    "description": "The default model for this thread",
                    "type": "string",
                    "example": "llama3.2:latest"
                },
                "title": {
                    "description": "The title of the chat thread",
                    "type": "string",
                    "example": "My Chat with AI"
                }
            }
        },
        "handlers.ErrorResponse": {
            "description": "Standard error response format",
            "type": "object",
            "properties": {
                "message": {
                    "description": "Error message description",
                    "type": "string",
                    "example": "Error message"
                }
            }
        },
        "handlers.ModelListResponse": {
            "description": "Information about an available model",
            "type": "object",
            "properties": {
                "details": {
                    "description": "Additional model details (format, family, etc.)",
                    "type": "object",
                    "additionalProperties": true
                },
                "digest": {
                    "description": "Model digest/hash",
                    "type": "string",
                    "example": "sha256:abc123..."
                },
                "modified_at": {
                    "description": "Last modification timestamp",
                    "type": "string",
                    "example": "2023-01-01T00:00:00Z"
                },
                "name": {
                    "description": "Model name and tag",
                    "type": "string",
                    "example": "llama3.2:latest"
                },
                "size": {
                    "description": "Model size in bytes",
                    "type": "integer",
                    "example": 4661224676
                }
            }
        },
        "handlers.PaginatedResponse-db_ChatThread": {
            "type": "object",
            "properties": {
                "current_page": {
                    "description": "Current page number",
                    "type": "integer"
                },
                "data": {
                    "description": "Array of data items",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/db.ChatThread"
                    }
                },
                "has_next": {
                    "description": "Whether there are more items available",
                    "type": "boolean"
                },
                "has_previous": {
                    "description": "Whether there are previous items available",
                    "type": "boolean"
                },
                "total": {
                    "description": "Total number of items",
                    "type": "integer"
                },
                "total_pages": {
                    "description": "Total number of pages",
                    "type": "integer"
                }
            }
        },
        "handlers.PaginatedResponse-db_Message": {
            "type": "object",
            "properties": {
                "current_page": {
                    "description": "Current page number",
                    "type": "integer"
                },
                "data": {
                    "description": "Array of data items",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/db.Message"
                    }
                },
                "has_next": {
                    "description": "Whether there are more items available",
                    "type": "boolean"
                },
                "has_previous": {
                    "description": "Whether there are previous items available",
                    "type": "boolean"
                },
                "total": {
                    "description": "Total number of items",
                    "type": "integer"
                },
                "total_pages": {
                    "description": "Total number of pages",
                    "type": "integer"
                }
            }
        },
        "handlers.PaginatedResponse-db_Translation": {
            "type": "object",
            "properties": {
                "current_page": {
                    "description": "Current page number",
                    "type": "integer"
                },
                "data": {
                    "description": "Array of data items",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/db.Translation"
                    }
                },
                "has_next": {
                    "description": "Whether there are more items available",
                    "type": "boolean"
                },
                "has_previous": {
                    "description": "Whether there are previous items available",
                    "type": "boolean"
                },
                "total": {
                    "description": "Total number of items",
                    "type": "integer"
                },
                "total_pages": {
                    "description": "Total number of pages",
                    "type": "integer"
                }
            }
        },
        "handlers.Response-any": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "The response data"
                }
            }
        },
        "handlers.Response-array_handlers_ModelListResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "The response data",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/handlers.ModelListResponse"
                    }
                }
            }
        },
        "handlers.Response-db_ChatThread": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "The response data",
                    "allOf": [
                        {
                            "$ref": "#/definitions/db.ChatThread"
                        }
                    ]
                }
            }
        },
        "handlers.Response-db_Translation": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "The response data",
                    "allOf": [
                        {
                            "$ref": "#/definitions/db.Translation"
                        }
                    ]
                }
            }
        },
        "handlers.Response-string": {
            "type": "object",
            "properties": {
                "data": {
                    "description": "The response data",
                    "type": "string"
                }
            }
        },
        "handlers.TranslateRequest": {
            "description": "Request payload for translating text between languages",
            "type": "object",
            "required": [
                "model",
                "source_language",
                "source_text",
                "target_language",
                "thread_id"
            ],
            "properties": {
                "model": {
                    "description": "The model to use for translation",
                    "type": "string",
                    "example": "llama3.2:latest"
                },
                "source_language": {
                    "description": "Source language code (e.g., 'fa', 'en', 'ar')",
                    "type": "string",
                    "example": "fa"
                },
                "source_text": {
                    "description": "The text to be translated",
                    "type": "string",
                    "example": "سلام دنیا"
                },
                "target_language": {
                    "description": "Target language code (e.g., 'fa', 'en', 'ar')",
                    "type": "string",
                    "example": "en"
                },
                "thread_id": {
                    "description": "The thread ID for this translation",
                    "type": "string",
                    "example": "123"
                },
                "tone": {
                    "description": "Translation tone (formal, casual, technical, friendly)",
                    "type": "string",
                    "example": "formal"
                }
            }
        },
        "handlers.UpdateChatThreadRequest": {
            "description": "Request payload for updating an existing chat thread",
            "type": "object",
            "required": [
                "title"
            ],
            "properties": {
                "title": {
                    "description": "The new title for the chat thread",
                    "type": "string",
                    "example": "Updated Chat Title"
                }
            }
        }
    },
    "securityDefinitions": {
        "BasicAuth": {
            "type": "basic"
        }
    }
}