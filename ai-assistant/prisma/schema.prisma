// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model Thread {
    id        String   @id @default(cuid())
    title     String?
    archived  Boolean  @default(false)
    pinned    Boolean  @default(false)
    favorite  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    messages Message[]

    @@index([createdAt])
    @@index([archived])
    @@index([pinned])
    @@index([favorite])
}

model Message {
    id         String        @id @default(cuid())
    content    String
    role       MessageRole
    status     MessageStatus @default(idle)
    reasoning  String?
    model      String?
    tokenCount Int?
    duration   Int?
    error      String?
    threadId   String
    createdAt  DateTime      @default(now())
    updatedAt  DateTime      @updatedAt

    thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

    @@index([threadId])
    @@index([createdAt])
    @@index([status])
}

enum MessageRole {
    user
    assistant
}

enum MessageStatus {
    idle
    reasoning
    streaming
    finished
    errored
    stopped
}
