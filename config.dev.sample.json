{
  "server": {
    "port": 3000,
    "corsOrigin": "http://localhost:3001",
    "host": "127.0.0.1"
  },
  "logging": {
    "level": "debug",
    "dir": "./logs",
    "pretty": true,
    "enableHttpLogging": true
  },
  "web": {
    "distDir": "./apps/web/dist"
  },
  "database": {
    "file": "./apps/server/data.db"
  },
  "whisper": {
    "modelsDir": "./whisper-models",
    "cacheDir": "./.whisper-cache",
    "wasmDir": "./node_modules/.bun/@huggingface+transformers@*/node_modules/@huggingface/transformers/dist",
    "allowRemoteModels": true,
    "allowedModels": ["Xenova/whisper-tiny", "Xenova/whisper-base"]
  },
  "ai": {
