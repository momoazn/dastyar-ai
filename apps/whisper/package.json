{
  "name": "whisper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uv run fastapi dev src/main.py --host 0.0.0.0 --port 8000",
    "build": "echo 'Python app build complete'",
    "start": "uv run fastapi run src/main.py --host 0.0.0.0 --port 8000",
    "install": "uv sync",
    "check-types": "echo 'Python type checking skipped'",
    "lint": "uv run ruff check src/",
    "format": "uv run ruff format src/"
  }
}