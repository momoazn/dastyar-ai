{
  "name": "whisper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "uv run fastapi dev src/main.py --host 0.0.0.0 --port ${WHISPER_PORT:-40002}",
    "dev:env": "WHISPER_PORT=${WHISPER_PORT:-40002} uv run fastapi dev src/main.py --host 0.0.0.0 --port $WHISPER_PORT",
    "build": "uv run python build.py",
    "build:clean": "rm -rf build dist __pycache__ && find . -name '*.pyc' -delete",
    "build:windows": "build.bat",
    "start": "uv run fastapi run src/main.py --host 0.0.0.0 --port ${WHISPER_PORT:-40002}",
    "start:env": "WHISPER_PORT=${WHISPER_PORT:-40002} uv run fastapi run src/main.py --host 0.0.0.0 --port $WHISPER_PORT",
    "install": "uv sync",
    "check-types": "echo 'Python type checking skipped'",
    "lint": "uv run ruff check src/",
    "format": "uv run ruff format src/"
  }
}
