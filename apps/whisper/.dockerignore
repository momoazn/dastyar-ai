# Docker ignore file for Whisper API
# Excludes unnecessary files from Docker build context

# Build artifacts
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation (keep only essential docs)
README.md
DEPLOYMENT.md
WINDOWS_BUILD.md
DOCKER_BUILD.md

# Test files
test_*.py
*_test.py
tests/

# Logs and temporary files
*.log
*.tmp
*.temp
logs/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Development tools
.pytest_cache/
.coverage
.nyc_output
coverage/
.ruff_cache/

# Package managers
node_modules/
.npm
.yarn/

# Large model files (keep only tiny model if needed)
models/base.pt
models/small.pt
models/medium.pt
models/large.pt
models/large-v2.pt
models/large-v3.pt
models/models--*

# Docker files (avoid recursion)
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Local environment files
.env
.env.local
.env.development
.env.test
.env.production

# Backup files
*.bak
*.backup
*.old