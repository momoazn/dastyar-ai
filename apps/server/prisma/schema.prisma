// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./data.db"
}

// Threads table – represents a chat thread
model Thread {
  id            Int       @id @default(autoincrement())
  title         String
  isArchived    Boolean   @default(false)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  messages Message[]

  @@map("threads")
}

// Messages table – individual messages inside a thread
model Message {
  id        Int           @id @default(autoincrement())
  parts     Json
  status    MessageStatus
  role      MessageRole
  modelName String
  threadId  Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Relations
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// Translations table – stores translation jobs & results
model Translation {
  id             Int          @id @default(autoincrement())
  sourceText     String
  translatedText String?
  modelName      String
  sourceLanguage LanguageCode
  targetLanguage LanguageCode
  tone           Tone?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("translations")
}

// Summaries table – stores summary jobs & results
model Summary {
  id          Int         @id @default(autoincrement())
  sourceText  String
  summaryText String?
  modelName   String
  mode        SummaryMode
  tone        Tone?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("summaries")
}

// Image Threads table – represents image conversation threads
model ImageThread {
  id            Int              @id @default(autoincrement())
  title         String
  isArchived    Boolean          @default(false)
  lastImageAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  images        GeneratedImage[]

  @@map("image_threads")
}

// Generated Images table – stores AI-generated images metadata
model GeneratedImage {
  id             Int      @id @default(autoincrement())
  prompt         String
  negativePrompt String?
  filePath       String
  fileName       String
  settings       String // JSON string of generation settings
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  imageThreadId  Int
  thread         ImageThread  @relation(fields: [imageThreadId], references: [id], onDelete: Cascade)

  @@index([imageThreadId], name: "idx_generated_images_thread")
  @@map("generated_images")
}

// Enums
enum MessageStatus {
  reasoning
  generating
  finished
  errored
  stopped
}

enum MessageRole {
  user
  assistant
}

enum LanguageCode {
  en
  fa
  ar
  fr
  de
  es
  it
  pt
  ru
  zh
  ja
  ko
  tr
  hi
  ur
}

enum Tone {
  formal
  informal
  business
  casual
  academic
  technical
  creative
  friendly
  professional
}

enum SummaryMode {
  concise
  standard
  detailed
}

// Code Assistant Sessions table – represents a code assistant session
model CodeAssistSession {
  id        Int      @id @default(autoincrement())
  title     String
  language  String // Programming language (e.g., "javascript", "python", "typescript")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  codeGenerations CodeGeneration[]
  codeReviews     CodeReview[]

  @@map("code_assist_sessions")
}

// Code Generations table – stores code generation history
model CodeGeneration {
  id            Int      @id @default(autoincrement())
  sessionId     Int
  prompt        String
  generatedCode String
  language      String
  modelUsed     String
  createdAt     DateTime @default(now())

  // Relations
  session CodeAssistSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("code_generations")
}

// Code Reviews table – stores code review results
model CodeReview {
  id             Int      @id @default(autoincrement())
  sessionId      Int
  codeInput      String
  reviewFeedback String
  suggestions    String // JSON string of suggestions
  severityLevels String // JSON string of severity levels
  createdAt      DateTime @default(now())

  // Relations
  session CodeAssistSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("code_reviews")
}
