generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  chatThreads        ChatThread[]
  messages           Message[]
  translations       Translation[]
  summaries          Summary[]
  imageThreads       ImageThread[]
  generatedImages    GeneratedImage[]
  codeAssistSessions CodeAssistSession[]
  codeGenerations    CodeGeneration[]
  codeReviews        CodeReview[]

  @@map("users")
}

model LLMModel {
  id        Int              @id @default(autoincrement())
  name      String
  provider  LLMModelProvider
  isEnabled Boolean          @default(true) @map("is_enabled")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  messages        Message[]
  translations    Translation[]
  summaries       Summary[]
  codeGenerations CodeGeneration[]
  codeReviews     CodeReview[]

  @@map("llm_models")
}

enum LLMModelProvider {
  ollama
  lmstudio
}

// Chat Threads table – represents a chat thread
model ChatThread {
  id            Int       @id @default(autoincrement())
  title         String
  isArchived    Boolean   @default(false) @map("is_archived")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  messages Message[]

  @@map("chat_threads")
}

// Messages table – individual messages inside a thread
model Message {
  id        Int           @id @default(autoincrement())
  parts     Json
  status    MessageStatus
  role      MessageRole
  modelId   Int           @map("model_id")
  threadId  Int           @map("thread_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  model  LLMModel   @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// Translations table – stores translation jobs & results
model Translation {
  id             Int          @id @default(autoincrement())
  sourceText     String
  translatedText String?
  modelId        Int          @map("model_id")
  sourceLanguage LanguageCode
  targetLanguage LanguageCode
  tone           Tone?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  model LLMModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("translations")
}

// Summaries table – stores summary jobs & results
model Summary {
  id          Int         @id @default(autoincrement())
  sourceText  String
  summaryText String?
  modelId     Int         @map("model_id")
  mode        SummaryMode
  tone        Tone?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  model LLMModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("summaries")
}

// Image Threads table – represents image conversation threads
model ImageThread {
  id          Int       @id @default(autoincrement())
  title       String
  isArchived  Boolean   @default(false) @map("is_archived")
  lastImageAt DateTime? @map("last_image_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  images GeneratedImage[]

  @@map("image_threads")
}

// Generated Images table – stores AI-generated images metadata
model GeneratedImage {
  id             Int      @id @default(autoincrement())
  prompt         String
  negativePrompt String?
  filePath       String
  fileName       String
  settings       String // JSON string of generation settings
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  threadId Int         @map("thread_id")
  thread   ImageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([threadId], name: "idx_generated_images_thread")
  @@map("generated_images")
}

// Enums
enum MessageStatus {
  reasoning
  generating
  finished
  errored
  stopped
}

enum MessageRole {
  user
  assistant
}

enum LanguageCode {
  en
  fa
  ar
  fr
  de
  es
  it
  pt
  ru
  zh
  ja
  ko
  tr
  hi
  ur
}

enum Tone {
  formal
  informal
  business
  casual
  academic
  technical
  creative
  friendly
  professional
}

enum SummaryMode {
  concise
  standard
  detailed
}

// Code Assistant Sessions table – represents a code assistant session
model CodeAssistSession {
  id        Int      @id @default(autoincrement())
  title     String
  language  String // Programming language (e.g., "javascript", "python", "typescript")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  codeGenerations CodeGeneration[]
  codeReviews     CodeReview[]

  @@map("code_assist_sessions")
}

// Code Generations table – stores code generation history
model CodeGeneration {
  id            Int      @id @default(autoincrement())
  sessionId     Int      @map("session_id")
  prompt        String
  generatedCode String
  language      String
  modelId       Int      @map("model_id")
  createdAt     DateTime @default(now()) @map("created_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  session CodeAssistSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  model   LLMModel          @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("code_generations")
}

// Code Reviews table – stores code review results
model CodeReview {
  id             Int      @id @default(autoincrement())
  sessionId      Int      @map("session_id")
  codeInput      String
  reviewFeedback String
  suggestions    String // JSON string of suggestions
  severityLevels String // JSON string of severity levels
  modelId        Int      @map("model_id")
  createdAt      DateTime @default(now()) @map("created_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  session CodeAssistSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  model   LLMModel          @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("code_reviews")
}
