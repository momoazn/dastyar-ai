{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --compile --minify --target bun --conditions=browser --external onnxruntime-node --external onnxruntime-gpu --external onnxruntime-openvino --outfile ./dist/dastyar-ai",
    "check-types": "tsc -b",
    "dev": "bun run --hot src/index.ts",
    "start": "./dist/dastyar-ai",
    "seed:models": "bun run src/scripts/seed-models.ts",
    "config:generate": "bun run src/scripts/config-generator.ts generate",
    "config:show": "bun run src/scripts/config-generator.ts show",
    "config:validate": "bun run src/scripts/config-generator.ts validate",
    "db:local": "bun run src/database/index.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.19",
    "@ai-sdk/provider": "^2.0.0",
    "@emnapi/core": "^1.5.0",
    "@emnapi/wasi-threads": "^1.1.0",
    "@hono/zod-validator": "^0.7.3",
    "@huggingface/transformers": "^3.7.5",
    "@orpc/client": "^1.9.3",
    "@orpc/server": "^1.9.3",
    "@prisma/client": "^6.17.0",
    "ai": "^5.0.61",
    "automatic1111-provider": "^0.1.1",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "hono": "^4.9.10",
    "jsonwebtoken": "^9.0.2",
    "ollama-ai-provider-v2": "^1.4.1",
    "onnxruntime-web": "^1.23.0",
    "openai": "^6.2.0",
    "wavefile": "^11.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.2.23",
    "@types/jsonwebtoken": "^9.0.10",
    "prisma": "^6.17.0",
    "typescript": "^5.9.3"
  },
  "browser": {
    "onnxruntime-node": false,
    "onnxruntime-gpu": false,
    "onnxruntime-openvino": false,
    "sharp": false
  }
}
