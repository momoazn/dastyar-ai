{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build src/index.ts --compile --minify --target bun --define NODE_ENV=\"production\"  --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "seed:models": "bun run src/scripts/seed-models.ts",
    "db:local": "bun run src/db/index.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate && bun run db:bundle",
    "db:migrate": "drizzle-kit migrate",
    "db:bundle": "bun run src/scripts/bundle-migrations.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.4",
    "@ai-sdk/groq": "^2.0.5",
    "@ai-sdk/openai-compatible": "^1.0.2",
    "@google/genai": "^1.13.0",
    "@openrouter/ai-sdk-provider": "^1.1.2",
    "@orpc/client": "^1.5.0",
    "@orpc/server": "^1.5.0",
    "ai": "^5.0.7",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.3",
    "groq-sdk": "^0.30.0",
    "hono": "^4.8.2",
    "openai": "^5.12.1",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.2.6",
    "drizzle-kit": "^0.31.2",
    "tsdown": "^0.12.9",
    "typescript": "^5.8.2"
  }
}
