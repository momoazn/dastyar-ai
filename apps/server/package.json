{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --compile --minify --target bun --conditions=browser --define NODE_ENV=\"production\" --external onnxruntime-node --external onnxruntime-gpu --external onnxruntime-openvino --outfile ./dist/dastyar-ai",
    "check-types": "tsc -b",
    "dev": "bun run --hot src/index.ts",
    "start": "./dist/dastyar-ai",
    "seed:models": "bun run src/scripts/seed-models.ts",
    "config:generate": "bun run src/scripts/config-generator.ts generate",
    "config:show": "bun run src/scripts/config-generator.ts show",
    "config:validate": "bun run src/scripts/config-generator.ts validate",
    "db:local": "bun run src/database/index.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate && bun run db:bundle",
    "db:migrate": "drizzle-kit migrate",
    "db:bundle": "bun run src/scripts/bundle-migrations.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.11",
    "@ai-sdk/groq": "^2.0.5",
    "@ai-sdk/openai-compatible": "^1.0.2",
    "@emnapi/core": "^1.4.5",
    "@emnapi/wasi-threads": "^1.0.4",
    "@google/genai": "^1.13.0",
    "@huggingface/transformers": "^3.7.2",
    "@openrouter/ai-sdk-provider": "^1.1.2",
    "@orpc/client": "^1.5.0",
    "@orpc/server": "^1.5.0",
    "ai": "^5.0.7",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.3",
    "groq-sdk": "^0.30.0",
    "hono": "^4.8.2",
    "hono-pino": "^0.10.2",
    "ollama-ai-provider-v2": "^1.2.1",
    "openai": "^5.12.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "wavefile": "^11.0.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.2.6",
    "drizzle-kit": "^0.31.2",
    "typescript": "^5.8.2"
  },
  "browser": {
    "onnxruntime-node": false,
    "onnxruntime-gpu": false,
    "onnxruntime-openvino": false,
    "sharp": false
  }
}
