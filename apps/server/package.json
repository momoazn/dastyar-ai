{
  "name": "server",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "bun db:bundle && bun build src/index.ts --compile --minify --target bun --outfile ./dist/dastyar-ai",
    "build:windows": "bun db:bundle && bun build src/index.ts --compile --minify --target bun-windows-x64 --outfile ./dist/dastyar-ai.exe",
    "check-types": "tsc -b",
    "dev": "bun run --hot src/index.ts",
    "start": "./dist/dastyar-ai",
    "seed:models": "bun run src/scripts/seed-models.ts",
    "config:generate": "bun run src/scripts/config-generator.ts generate",
    "config:show": "bun run src/scripts/config-generator.ts show",
    "config:validate": "bun run src/scripts/config-generator.ts validate",
    "db:local": "bun run src/database/index.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:bundle": "bun run src/scripts/bundle-migrations.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.23",
    "@ai-sdk/groq": "^2.0.24",
    "@ai-sdk/openai-compatible": "^1.0.19",
    "@ai-sdk/provider": "^2.0.0",
    "@emnapi/core": "^1.5.0",
    "@emnapi/wasi-threads": "^1.1.0",
    "@hono/zod-validator": "^0.7.3",
    "@openrouter/ai-sdk-provider": "^1.2.0",
    "@orpc/client": "^1.9.3",
    "@orpc/server": "^1.9.3",
    "ai": "^5.0.61",
    "automatic1111-provider": "^0.1.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.6",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.9.10",
    "jsonwebtoken": "^9.0.2",
    "ollama-ai-provider-v2": "^1.4.1",
    "openai": "^6.2.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.2.23",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-kit": "^0.31.5",
    "typescript": "^5.9.3"
  },
  "browser": {
    "sharp": false
  }
}
