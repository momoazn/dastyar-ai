# Server Configuration
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=*

# Authentication
# ⚠️ CRITICAL: This is a development default. REGENERATE for production!
# Generate a new secure key with: openssl rand -base64 48
# This default value is shared in the repository - DO NOT use in production
JWT_SECRET=***REMOVED***

# Database
DATABASE_FILE=./data.db

# Whisper
WHISPER_MODELS_DIR=./whisper-models
WHISPER_CACHE_DIR=./.whisper-cache
WHISPER_WASM_DIR=./node_modules/.bun/@huggingface+transformers@*/node_modules/@huggingface/transformers/dist
WHISPER_MODELS=Xenova/whisper-tiny

# AI Providers
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=true
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_ENABLED=false

# Image Generation
STABLE_DIFFUSION_URL=http://localhost:7860
STABLE_DIFFUSION_ENABLED=true

# Assets
IMAGES_DIR=./generated-images
WEB_DIST_DIR=./web