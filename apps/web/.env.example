# Web app environment
# When served by the backend in production, these proxy values are only used for local dev (Vite).
# Local dev defaults (Vite)
WEB_PORT=3001
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
SERVER_PROTOCOL=http

# If you need to point Vite at a remote/staging API during development, override below:
# SERVER_HOST=your-api.example.com
# SERVER_PORT=443
# SERVER_PROTOCOL=https

# Frontend logging
VITE_LOG_LEVEL=info
