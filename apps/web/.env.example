# Web app environment
# Copy to .env.local only when local defaults need to be overridden.

# Vite dev server
WEB_PORT=3001

# Vite dev proxy target
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
SERVER_PROTOCOL=http

# Remote/staging API override example:
# SERVER_HOST=your-api.example.com
# SERVER_PORT=443
# SERVER_PROTOCOL=https

# Frontend logging: debug, info, warn, error
VITE_LOG_LEVEL=info
