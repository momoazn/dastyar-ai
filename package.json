{
  "name": "dastyar-ai",
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/bun": "^1.2.19",
    "@types/node": "^24.2.1",
    "bun-types": "^1.2.19",
    "turbo": "^2.5.4",
    "ultracite": "5.1.1"
  },
  "packageManager": "bun@1.2.19",
  "private": true,
  "scripts": {
    "check": "biome check --write .",
    "dev": "turbo dev",
    "build": "turbo build",
    "build:web": "turbo -F web build",
    "build:server": "turbo -F server build",
    "build:server:win": "turbo -F server build:win",
    "build:all": "bun run build:web && bun run build:server && bun run copy-config:sample",
    "build:all:win": "bun run build:web && bun run build:server:win && bun run copy-config:sample:win",
    "compile": "turbo -F server compile",
    "check-types": "turbo check-types",
    "compile:server": "turbo -F server build",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "config:generate": "turbo -F server config:generate",
    "config:show": "turbo -F server config:show",
    "config:validate": "turbo -F server config:validate",
    "db:push": "turbo -F server db:push",
    "db:studio": "turbo -F server db:studio",
    "db:generate": "turbo -F server db:generate",
    "db:migrate": "turbo -F server db:migrate",
    "copy-config:sample": "cp config.prod.sample.json dist/config.prod.json",
    "copy-config:sample:win": "copy config.prod.sample.json dist\\config.prod.json"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@emnapi/core": "^1.4.5"
  }
}
