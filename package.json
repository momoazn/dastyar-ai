{
  "name": "persian-ai-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "web:dev": "bunx --bun vite",
    "web:build": "bunx --bun vite build --emptyOutDir",
    "web:preview": "bun run web:build && bunx --bun vite preview",
    "api:dev": "bun --watch api/index.ts",
    "api:build": "bun build api/index.ts --outdir ./api-dist",
    "api:start": "bun run api:build && bun run ./api-dist/index.js",
    "api:compile": "bun compile api/index.ts --outfile persian-ai-assistant-api --minify --sourcemap",
    "pb:dev": "air",
    "pb:build": "go build -o persian-ai-assistant main.go",
    "pb:build:win": "go build -o persian-ai-assistant.exe main.go",
    "pb:typegen": "bunx --bun pocketbase-typegen --db ./data/data.db --out src/lib/pocketbase-types.ts",
    "pb:start": "go run main.go",
    "pb:start:prod": "./persian-ai-assistant",
    "dev": "npm-run-all -p web:dev pb:dev api:dev",
    "start": "npm-run-all -p web:preview pb:start api:start",
    "build": "bun run web:build && bun run pb:build",
    "build:win": "bun run web:build && bun run pb:build:win",
    "build:check": "bun run type-check && bun run lint",
    "lint": "bunx --bun eslint .",
    "lint:fix": "bunx --bun eslint . --fix",
    "fmt": "bunx --bun prettier --write .",
    "fmt:check": "bunx --bun prettier --check .",
    "type-check": "bunx --bun tsc --noEmit",
    "clean": "rm -rf dist node_modules/.cache",
    "clean:all": "rm -rf dist node_modules/.cache data/storage/* tmp/*",
    "install:clean": "rm -rf node_modules bun.lockb && bun install"
  },
  "dependencies": {
    "@ai-sdk/react": "^1.2.12",
    "@fontsource-variable/vazirmatn": "^5.2.6",
    "@langchain/core": "^0.3.57",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/ollama": "^0.2.0",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tailwindcss/vite": "^4.1.8",
    "@tanstack/react-query": "^5.79.0",
    "@tanstack/react-query-devtools": "^5.79.0",
    "ai": "^4.3.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.7.10",
    "jotai": "^2.12.5",
    "langchain": "^0.3.27",
    "lucide-react": "^0.511.0",
    "ollama": "^0.5.16",
    "ollama-ai-provider": "^1.2.0",
    "pdf-parse": "^1.1.1",
    "pocketbase": "^0.26.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.6.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.2",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/eslint-plugin-query": "^5.78.0",
    "@types/bun": "^1.2.15",
    "@types/node": "^22.15.27",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "npm-run-all": "^4.1.5",
    "pocketbase-typegen": "^1.3.1",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
