{
  "name": "dastyar-ai",
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.2.1",
    "turbo": "^2.5.8",
    "ultracite": "5.6.2"
  },
  "packageManager": "bun@1.3.0",
  "private": true,
  "scripts": {
    "check-types": "turbo check-types",
    "dev": "turbo dev",
    "build": "bun run build.ts",
    "build:windows": "bun run build.ts -- --platform windows",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "config:generate": "turbo -F server config:generate",
    "config:show": "turbo -F server config:show",
    "config:validate": "turbo -F server config:validate",
    "db:push": "turbo -F server db:push",
    "db:studio": "turbo -F server db:studio",
    "db:generate": "turbo -F server db:generate",
    "db:migrate": "turbo -F server db:migrate"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@emnapi/core": "^1.4.5"
  }
}
